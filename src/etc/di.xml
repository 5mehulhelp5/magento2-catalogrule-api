<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="SR\CatalogRuleApi\Api\RuleRepositoryInterface"
                type="SR\CatalogRuleApi\Model\RuleRepository" />
    <preference for="SR\CatalogRuleApi\Api\RuleManagementInterface"
                type="SR\CatalogRuleApi\Model\RuleManagement" />
    <preference for="SR\CatalogRuleApi\Api\Data\RuleInterface"
                type="SR\CatalogRuleApi\Model\Data\Rule" />
    <preference for="SR\CatalogRuleApi\Api\Data\RuleSearchResultInterface"
                type="Magento\Framework\Api\SearchResults" />
    <type name="SR\CatalogRuleApi\Model\Data\Validator">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="required" xsi:type="object">SR\CatalogRuleApi\Model\Data\Validator\RequiredFields</item>
                <item name="dates" xsi:type="object">SR\CatalogRuleApi\Model\Data\Validator\DateRange</item>
                <item name="condition" xsi:type="object">SR\CatalogRuleApi\Model\Data\Validator\ConditionType</item>
            </argument>
        </arguments>
    </type>
</config>
